# Service ingress IP fallback; no forced DNS lookup for these rules.
# Both IPv4 and IPv6 literals use Shadowrocket's IP-CIDR rule syntax.
# Adding an IPv6 rule does not change the app's IPv6 setting.
IP-CIDR,160.79.104.0/23,PROXY,no-resolve
IP-CIDR,2607:6bc0::/48,PROXY,no-resolve
