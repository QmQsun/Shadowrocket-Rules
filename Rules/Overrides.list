# Local priority rules, applied before upstream ad/IP/domain rules.
# Shadowrocket uses PROTOCOL,UDP inside logical rules, not Clash NETWORK,udp.
# Targeted UDP/443 rejection only when these domain conditions match.
# This does not block all UDP/STUN and does not prove WebRTC/DNS leak protection.
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,claude.ai)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,claude.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,api.anthropic.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,anthropic.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,anthropic-cdn.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,claudeusercontent.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,claudemcpcontent.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,http-intake.logs.us5.datadoghq.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,browser-intake-us5-datadoghq.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,ip.net.coffee)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,clau.de)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,claudemcpclient.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,anthropic.auth0.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,anthropic-com.ghost.io)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,servd-anthropic-website.b-cdn.net)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,anthropic.com.cdn.cloudflare.net)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,statsigapi.net)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,intercom.io)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,intercomcdn.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,challenges.cloudflare.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN,static.cloudflareinsights.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,cloudflare.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,usefathom.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-KEYWORD,datadoghq)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,statsig.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,sentry.io)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,api.segment.io)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,segment.io)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,segment.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,stripe.com)),REJECT-NO-DROP
AND,((PROTOCOL,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,stripe.network)),REJECT-NO-DROP

# Core, content, telemetry, payment, verification, support, and test-site routing.
# Service-specific hosts remain narrow on shared hosting providers.
DOMAIN-SUFFIX,claude.ai,PROXY
DOMAIN-SUFFIX,claude.com,PROXY
